; D4VR Lab: independent geometry and camera calibration, no game integration.
config_version=5

[application]
config/name="D4VR · Stereo Lab"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.014, 0.019, 0.026, 1)

[xr]
openxr/enabled=true
openxr/default_action_map="res://xr_actions.tres"
openxr/reference_space=1
shaders/enabled=true

[physics]
common/physics_ticks_per_second=90
