  "physical_aliases_excluded": false,
  "copy_transport": "read-only PhysicalStorageBuffer source to private coherent destination; no TRANSFER_SRC source usage required",
  "snapshot_scope": "after first completed fixture submission, before source updates; matches first captured submission",
  "kernel_capabilities": [
    "Shader",
    "PhysicalStorageBufferAddresses"
  ],
  "contract": [
    "caller owns source/destination lifetimes and excludes physical aliases and writers",
    "caller synchronizes source producers and externally synchronizes compute-capable queue",
    "private command buffer outside rendering; bounded whole batch validated before recording",
    "barriers order same-queue producers/coherent host writes and results to host; caller waits completion fence",
    "not a capture admission contract for arbitrary game resources"
  ],
  "limits": {
    "spans": 32,
    "total_payload_bytes": 1048576,
    "alignment_bytes": 4,
    "push_constant_bytes": 24
  },
