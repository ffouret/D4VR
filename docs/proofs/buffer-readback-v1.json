    "python_tests": 158,
    "strict_readback_bounds_tests": "passed",
    "rejects": [
      "empty/over-budget batch",
      "unaligned/null/overflowing addresses",
      "missing BDA or destination storage usage",
      "out-of-buffer offsets and sizes",
      "cross-copy source/target VA overlap",
      "overlapping destinations",
      "missing dispatch before recording"
    ],
    "all_invalid_batches_record_zero_commands": true,
    "shader_spirv_validation": "passed Vulkan1.2",
    "portable_ci_tests": "Linux/Windows; sanitizer target added for Linux"
  },
